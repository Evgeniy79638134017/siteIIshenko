<section class="relative overflow-hidden">
  <div id="vanta-cta" class="absolute inset-0 mesh-gradient"></div>
  <div class="relative z-10 py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading font-bold text-3xl md:text-4xl text-white">Готов внедрить систему продаж на базе ИИ?</h2>
      <p class="text-white/75 text-lg mt-4 leading-relaxed">Начни с бесплатной диагностики — 15-20 минут, без обязательств</p>

      <div class="mt-8">
        <a href="https://t.me/Evgen_isch" target="_blank" rel="noopener noreferrer" class="glow-pulse inline-flex items-center justify-center bg-accent text-white px-10 py-4 rounded-xl font-bold text-lg hover:bg-accent-hover hover:scale-[1.02] shadow-lg shadow-accent/25 transition-all duration-200">Записаться на диагностику</a>
      </div>

      <div class="mt-4">
        <a href="https://t.me/Evgen_isch" target="_blank" class="text-white/50 hover:text-white/80 transition-colors text-sm">Или напиши напрямую: @Evgen_isch</a>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  async function initVantaCTA() {
    const canvas = document.createElement('canvas');
    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
    if (!gl) return;
    if (window.innerWidth < 768 && navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const VANTA = await import('vanta/dist/vanta.fog.min');

      window.__vantaCTA = VANTA.default({
        el: '#vanta-cta',
        THREE: THREE,
        mouseControls: true,
        touchControls: false,
        gyroControls: false,
        minHeight: 200,
        minWidth: 200,
        highlightColor: 0x227a85,
        midtoneColor: 0x164550,
        lowlightColor: 0x0d2a38,
        baseColor: 0x0b2230,
        blurFactor: 0.5,
        speed: 1.3,
        zoom: 0.8,
      });
    } catch (e) {
      console.log('Vanta CTA not loaded, using CSS fallback');
    }
  }
  if (document.readyState === 'complete') {
    initVantaCTA();
  } else {
    window.addEventListener('load', initVantaCTA);
  }
  document.addEventListener('astro:before-swap', () => {
    if (window.__vantaCTA) {
      window.__vantaCTA.destroy();
      window.__vantaCTA = null;
    }
  });
</script>
