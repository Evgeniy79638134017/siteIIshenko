---
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- VIDEO BACKGROUND -->
  <div class="absolute inset-0 z-0">
    <!-- Desktop video -->
    <video
      id="hero-video"
      class="hidden md:block absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/hero-poster.jpg"
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>

    <!-- Mobile video (легче) -->
    <video
      id="hero-video-mobile"
      class="md:hidden absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/hero-poster.jpg"
    >
      <source src="/videos/hero-bg-mobile.mp4" type="video/mp4" />
    </video>

    <!-- Fallback poster для слабых устройств -->
    <img
      src="/videos/hero-poster.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      id="hero-poster-fallback"
      style="display: none;"
    />
  </div>

  <!-- OVERLAY — "туман" поверх видео -->
  <div class="absolute inset-0 z-1" style="
    background: linear-gradient(
      135deg,
      rgba(11, 34, 48, 0.85) 0%,
      rgba(22, 69, 80, 0.7) 30%,
      rgba(11, 34, 48, 0.75) 60%,
      rgba(15, 43, 60, 0.85) 100%
    );
  "></div>

  <!-- Дополнительный gradient снизу для плавного перехода к следующей секции -->
  <div class="absolute bottom-0 left-0 right-0 h-32 z-1 bg-gradient-to-t from-bg to-transparent"></div>

  <!-- CONTENT -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
    <div class="max-w-3xl">

      <!-- Заголовок -->
      <h1 class="split-heading font-heading font-bold text-4xl md:text-5xl lg:text-6xl leading-tight mb-6 text-white" style="word-break: keep-all; overflow-wrap: break-word; hyphens: none;">
        Внедри систему продаж на&nbsp;базе&nbsp;ИИ&nbsp;— за&nbsp;4&nbsp;недели
      </h1>

      <!-- Подзаголовок -->
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-xl leading-relaxed">
        Мастер-практикум для предпринимателей. Проверено на проекте с оборотом 120&nbsp;млн₽/год. 500+ вопросов распаковки → ИИ&#8209;помощники → вирусный контент → воронки → посадочные.
      </p>

      <!-- CTA кнопки -->
      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        <a href="https://t.me/Evgen_isch" target="_blank" rel="noopener noreferrer"
          class="glow-pulse inline-flex items-center justify-center bg-accent hover:bg-accent/90 text-white font-semibold rounded-xl px-8 py-4 text-lg transition-all duration-300 hover:scale-[1.02]">
          Записаться на бесплатную диагностику
        </a>
      </div>
      <p class="text-sm text-white/50 mt-3">20 минут на анкету → 50-70 страниц аналитики твоего бизнеса. Бесплатно.</p>

      <!-- Метрики -->
      <div class="flex gap-8 md:gap-12">
        <div>
          <span class="counter block font-heading font-bold text-2xl md:text-3xl text-accent" data-target="23">23</span>
          <span class="text-sm text-white/60">в бизнесе</span>
        </div>
        <div>
          <span class="block font-heading font-bold text-2xl md:text-3xl text-accent">600+</span>
          <span class="text-sm text-white/60">выпускников</span>
        </div>
        <div>
          <span class="counter block font-heading font-bold text-2xl md:text-3xl text-accent" data-target="46">46</span>
          <span class="text-sm text-white/60">стран</span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // --- Video fallback для слабых устройств ---
  (function() {
    const video = document.getElementById('hero-video') || document.getElementById('hero-video-mobile');
    const poster = document.getElementById('hero-poster-fallback');

    if (video) {
      // Если prefers-reduced-motion — показываем постер
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.style.display = 'none';
        if (poster) poster.style.display = 'block';
        return;
      }

      // Если видео не может воспроизвестись — fallback на постер
      video.addEventListener('error', () => {
        video.style.display = 'none';
        if (poster) poster.style.display = 'block';
      });

      // Таймаут: если за 5 секунд не заиграло — постер
      setTimeout(() => {
        if (video.readyState < 2) {
          video.style.display = 'none';
          if (poster) poster.style.display = 'block';
        }
      }, 5000);
    }
  })();
</script>
