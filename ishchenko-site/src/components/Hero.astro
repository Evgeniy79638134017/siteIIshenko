<section data-hero class="relative overflow-hidden min-h-[90vh] md:min-h-[85vh] flex items-center">
  <!-- Vanta.js container (абсолютный фон) -->
  <div id="vanta-hero" class="absolute inset-0 mesh-gradient"></div>
  <!-- Контент поверх -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 md:pt-40 pb-20 md:pb-28 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left column: text -->
      <div>
        <!-- Promo badge -->
        <div class="inline-flex items-center gap-2 bg-accent/20 text-accent px-4 py-1.5 rounded-full text-sm font-semibold mb-6">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          До 4 марта — текущие цены. После — +15%
        </div>

        <!-- Heading -->
        <h1 class="font-heading font-bold text-white" style="font-size: clamp(2.25rem, 5vw, 3.5rem);">
          Внедри систему продаж на&nbsp;базе&nbsp;ИИ — за&nbsp;4&nbsp;недели
        </h1>

        <!-- Subheading -->
        <p class="mt-6 text-white/75 text-lg md:text-xl leading-relaxed">
          Мастер-практикум для предпринимателей. Проверено на&nbsp;проекте с&nbsp;оборотом 120&nbsp;млн₽/год. 500+ вопросов распаковки&nbsp;→ ИИ&#8209;помощники&nbsp;→ вирусный контент&nbsp;→ воронки&nbsp;→ посадочные.
        </p>

        <!-- CTA buttons -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="/contacts" class="inline-flex items-center justify-center bg-accent text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-accent-hover hover:scale-[1.02] shadow-lg shadow-accent/25 transition-all duration-200">
            Получить систему продаж
          </a>
          <a href="#program" class="inline-flex items-center justify-center border-2 border-white/30 text-white px-8 py-4 rounded-xl font-semibold hover:bg-white/10 transition-all duration-200">
            Смотреть программу
          </a>
        </div>

        <!-- Trust metrics -->
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
          <div>
            <span class="text-accent font-heading font-bold text-2xl">23 года</span>
            <span class="text-white/50 text-sm block">в бизнесе</span>
          </div>
          <div>
            <span class="text-accent font-heading font-bold text-2xl">600+</span>
            <span class="text-white/50 text-sm block">выпускников</span>
          </div>
          <div>
            <span class="text-accent font-heading font-bold text-2xl">46 стран</span>
            <span class="text-white/50 text-sm block">клиенты</span>
          </div>
        </div>
      </div>

      <!-- Right column: photo placeholder (desktop only) -->
      <div class="hidden lg:block">
        <div class="relative">
          <div class="aspect-[3/4] max-w-md mx-auto bg-white/10 rounded-2xl backdrop-blur-sm border border-white/10 flex items-center justify-center">
            <span class="text-white/30 text-sm">Фото Евгения</span>
          </div>
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-accent/20 rounded-2xl -z-10 parallax-slow"></div>
          <div class="absolute -top-6 -left-6 w-24 h-24 bg-primary-light/20 rounded-full -z-10 parallax-slow"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';
  async function initVanta() {
    const canvas = document.createElement('canvas');
    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
    if (!gl) return;
    if (window.innerWidth < 768 && navigator.hardwareConcurrency && navigator.hardwareConcurrency < 4) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const VANTA = await import('vanta/dist/vanta.fog.min');

      window.__vantaHero = VANTA.default({
        el: '#vanta-hero',
        THREE: THREE,
        mouseControls: true,
        touchControls: false,
        gyroControls: false,
        minHeight: 200,
        minWidth: 200,
        highlightColor: 0x1A535C,
        midtoneColor: 0x0F2B3C,
        lowlightColor: 0x0a1e2e,
        baseColor: 0x0F2B3C,
        blurFactor: 0.6,
        speed: 1.2,
        zoom: 0.8,
      });
    } catch (e) {
      console.log('Vanta.js not loaded, using CSS fallback');
    }
  }
  if (document.readyState === 'complete') {
    initVanta();
  } else {
    window.addEventListener('load', initVanta);
  }
  document.addEventListener('astro:before-swap', () => {
    if (window.__vantaHero) {
      window.__vantaHero.destroy();
      window.__vantaHero = null;
    }
  });
</script>
