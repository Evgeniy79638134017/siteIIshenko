---
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/program', label: 'Программа' },
  { href: '/cases', label: 'Кейсы' },
  { href: '/about', label: 'Обо мне' },
  { href: '/contacts', label: 'Контакты' },
];
---
<footer class="bg-bg-dark text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Column 1: About -->
      <div>
        <span class="font-heading font-bold text-xl text-white">Евгений Ищенко</span>
        <p class="text-white/60 text-sm mt-2">Эксперт по продажам в соцсетях и автоматизации бизнеса на базе ИИ</p>
        <a href="https://t.me/Evgen_isch" target="_blank" class="mt-4 flex items-center gap-2 text-white/60 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span class="text-sm">@Evgen_isch</span>
        </a>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Навигация</h3>
        <ul class="space-y-3">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contacts -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Контакты</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <span class="text-white/60">Telegram: </span>
            <a href="https://t.me/Evgen_isch" target="_blank" class="text-white/60 hover:text-white transition-colors">@Evgen_isch</a>
          </li>
          <li class="text-white/60">Благовещенск / Онлайн</li>
          <li class="text-white/60">Офлайн и Zoom-формат</li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/40 text-xs">
        ИП Ищенко Евгений Владимирович · ИНН: 280601828814
      </p>
      <div class="flex gap-4 text-xs">
        <a href="/privacy" class="text-white/40 hover:text-white/70 transition-colors">Политика конфиденциальности</a>
        <a href="/terms" class="text-white/40 hover:text-white/70 transition-colors">Оферта</a>
      </div>
    </div>
    <p class="text-center text-white/30 text-xs mt-4">
      &copy; 2025 Евгений Ищенко. Все права защищены.
    </p>
  </div>
</footer>
