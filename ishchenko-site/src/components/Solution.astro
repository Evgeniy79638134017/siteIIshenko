<section class="bg-bg relative overflow-hidden py-16 md:py-20">
  <!-- Particles background -->
  <div id="particles-solution" class="absolute inset-0 z-0 opacity-30"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="split-heading font-heading font-bold text-3xl md:text-4xl text-text text-center">Что если бы у тебя были<br class="hidden sm:block" /> <span class="text-primary">нейросотрудники</span>?</h2>
    <p class="text-text-muted text-lg text-center mt-4 max-w-2xl mx-auto">Не просто инструменты — а ИИ-помощники, обученные на ДНК твоего бизнеса</p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 reveal-group">
      <div class="glass-card rounded-2xl p-8 reveal-item tilt-card">
        <div class="w-12 h-12 bg-success/10 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </div>
        <p class="text-text text-lg leading-relaxed">Знают твой бизнес через <strong class="text-text">500+ вопросов распаковки</strong> — и&nbsp;создают контент в&nbsp;ТВОЁМ стиле</p>
      </div>

      <div class="glass-card rounded-2xl p-8 reveal-item tilt-card">
        <div class="w-12 h-12 bg-success/10 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </div>
        <p class="text-text text-lg leading-relaxed">Генерируют <strong class="text-text">вирусный контент</strong>: карусели, Reels, гайды — за&nbsp;минуты вместо часов</p>
      </div>

      <div class="glass-card rounded-2xl p-8 reveal-item tilt-card">
        <div class="w-12 h-12 bg-success/10 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </div>
        <p class="text-text text-lg leading-relaxed">Прогревают клиентов <strong class="text-text">автоматически</strong> — воронки работают 24/7 без твоего участия</p>
      </div>

      <div class="glass-card rounded-2xl p-8 reveal-item tilt-card">
        <div class="w-12 h-12 bg-success/10 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </div>
        <p class="text-text text-lg leading-relaxed">Конвертируют трафик в&nbsp;заявки — <strong class="text-text">посадочные страницы</strong>, которые продают</p>
      </div>
    </div>
  </div>
</section>

<script>
  async function initParticles() {
    if (window.innerWidth < 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const { tsParticles } = await import('tsparticles');
      const { loadSlim } = await import('@tsparticles/slim');
      await loadSlim(tsParticles);
      await tsParticles.load({
        id: 'particles-solution',
        options: {
          fullScreen: { enable: false },
          background: { color: 'transparent' },
          particles: {
            number: { value: 50, density: { enable: true, width: 800, height: 800 } },
            color: { value: '#1A535C' },
            links: {
              enable: true,
              color: '#1A535C',
              distance: 180,
              opacity: 0.25,
              width: 1,
            },
            move: {
              enable: true,
              speed: 0.6,
              direction: 'none',
              outModes: { default: 'bounce' },
            },
            size: { value: { min: 1, max: 3 } },
            opacity: { value: { min: 0.15, max: 0.4 } },
          },
          interactivity: {
            events: {
              onHover: { enable: true, mode: 'grab' },
            },
            modes: {
              grab: { distance: 200, links: { opacity: 0.4 } },
            },
          },
          detectRetina: true,
        },
      });
    } catch (e) {
      console.log('tsParticles not loaded:', e);
    }
  }
  if (document.readyState === 'complete') {
    initParticles();
  } else {
    window.addEventListener('load', initParticles);
  }
</script>
