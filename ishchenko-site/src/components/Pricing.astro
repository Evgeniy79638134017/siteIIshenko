<script>
  const DEADLINE = new Date('2026-03-05T23:59:59+09:00').getTime();

  function isDiscountExpired() {
    return Date.now() >= DEADLINE;
  }

  function updateCountdown() {
    const now = Date.now();
    const diff = DEADLINE - now;
    if (diff <= 0) return;

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((diff % (1000 * 60)) / 1000);

    const days = document.getElementById('days');
    const hours = document.getElementById('hours');
    const minutes = document.getElementById('minutes');
    const seconds = document.getElementById('seconds');

    if (days) days.textContent = String(d).padStart(2, '0');
    if (hours) hours.textContent = String(h).padStart(2, '0');
    if (minutes) minutes.textContent = String(m).padStart(2, '0');
    if (seconds) seconds.textContent = String(s).padStart(2, '0');
  }

  // Если скидка истекла — показать обычные цены, никаких анимаций
  if (isDiscountExpired()) {
    // Обычные цены уже видны по умолчанию, ничего не делаем
  } else {
    // Скидка активна — запустить таймер и Intersection Observer
    updateCountdown();
    const countdownInterval = setInterval(() => {
      if (isDiscountExpired()) {
        clearInterval(countdownInterval);
        return;
      }
      updateCountdown();
    }, 1000);

    let discountAnimated = false;

    const pricingSection = document.getElementById('pricing');
    if (pricingSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !discountAnimated) {
            discountAnimated = true;
            observer.disconnect();
            // Через 5 секунд — запустить анимацию скидки
            setTimeout(() => {
              if (isDiscountExpired()) return;
              revealDiscountPrices();
              showDiscountBanner();
            }, 5000);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(pricingSection);
    }
  }

  function revealDiscountPrices() {
    const cards = document.querySelectorAll('[data-price-card]');
    cards.forEach((card, index) => {
      setTimeout(() => {
        const originalPrice = card.querySelector('.original-price');
        const discountPrice = card.querySelector('.discount-price');
        if (!originalPrice || !discountPrice) return;

        // Оригинальная цена: уменьшить, сделать серой, зачеркнуть
        const priceSpan = originalPrice.querySelector('.font-heading');
        const currencySpan = originalPrice.querySelector('.text-lg');
        if (priceSpan) {
          priceSpan.style.transition = 'all 0.5s ease';
          priceSpan.style.fontSize = '1.125rem';
          priceSpan.style.color = 'var(--color-text-muted)';
          priceSpan.style.textDecoration = 'line-through';
          priceSpan.style.fontWeight = '400';
        }
        if (currencySpan) {
          currencySpan.style.transition = 'all 0.5s ease';
          currencySpan.style.fontSize = '0.875rem';
          currencySpan.style.textDecoration = 'line-through';
        }

        // Показать скидочную цену с анимацией fade-in + slide-up
        discountPrice.style.display = 'block';
        // Форсируем reflow для запуска transition
        discountPrice.offsetHeight;
        discountPrice.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        discountPrice.style.opacity = '1';
        discountPrice.style.transform = 'translateY(0)';
      }, index * 200);
    });
  }

  function showDiscountBanner() {
    const banner = document.getElementById('discount-banner');
    if (!banner) return;

    banner.style.display = 'block';
    // Форсируем reflow
    banner.offsetHeight;
    banner.style.transition = 'transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease';
    banner.style.transform = 'translateY(0)';
    banner.style.opacity = '1';
  }

  // Обработчик закрытия баннера
  const closeBtn = document.getElementById('banner-close-btn');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      const banner = document.getElementById('discount-banner');
      if (!banner) return;

      // Баннер улетает вниз
      banner.style.transition = 'transform 0.6s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.6s ease';
      banner.style.transform = 'translateY(100vh)';
      banner.style.opacity = '0';

      banner.addEventListener('transitionend', function handler() {
        banner.removeEventListener('transitionend', handler);
        banner.style.display = 'none';

        // Показать компактную плашку под карточками
        const badge = document.getElementById('compact-discount-badge');
        if (badge) {
          badge.style.display = 'block';
          badge.offsetHeight;
          badge.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          badge.style.opacity = '1';
          badge.style.transform = 'translateY(0)';
        }
      }, { once: true });
    });
  }
</script>
