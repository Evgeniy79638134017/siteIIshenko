<script>
  const DEADLINE = new Date('2026-03-05T23:59:59+09:00').getTime();

  function isDiscountExpired() {
    return Date.now() >= DEADLINE;
  }

  function updateCountdown() {
    const now = Date.now();
    const diff = DEADLINE - now;
    if (diff <= 0) return;

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((diff % (1000 * 60)) / 1000);

    const days = document.getElementById('days');
    const hours = document.getElementById('hours');
    const minutes = document.getElementById('minutes');
    const seconds = document.getElementById('seconds');

    if (days) days.textContent = String(d).padStart(2, '0');
    if (hours) hours.textContent = String(h).padStart(2, '0');
    if (minutes) minutes.textContent = String(m).padStart(2, '0');
    if (seconds) seconds.textContent = String(s).padStart(2, '0');
  }

  /* ---------- Анимация цен (без изменений) ---------- */
  function revealDiscountPrices() {
    const cards = document.querySelectorAll('[data-price-card]');
    cards.forEach((card, index) => {
      setTimeout(() => {
        const originalPrice = card.querySelector('.original-price');
        const discountPrice = card.querySelector('.discount-price');
        if (!originalPrice || !discountPrice) return;

        const priceSpan = originalPrice.querySelector('.font-heading');
        const currencySpan = originalPrice.querySelector('.text-lg');
        if (priceSpan) {
          priceSpan.style.transition = 'all 0.5s ease';
          priceSpan.style.fontSize = '1.125rem';
          priceSpan.style.color = 'var(--color-text-muted)';
          priceSpan.style.textDecoration = 'line-through';
          priceSpan.style.fontWeight = '400';
        }
        if (currencySpan) {
          currencySpan.style.transition = 'all 0.5s ease';
          currencySpan.style.fontSize = '0.875rem';
          currencySpan.style.textDecoration = 'line-through';
        }

        discountPrice.style.display = 'block';
        discountPrice.offsetHeight;
        discountPrice.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        discountPrice.style.opacity = '1';
        discountPrice.style.transform = 'translateY(0)';
      }, index * 200);
    });
  }

  /* ---------- Мгновенное применение скидочного состояния (повторный визит) ---------- */
  function applyDiscountedStateImmediately() {
    const banner = document.getElementById('discount-banner');
    if (banner) {
      banner.style.display = 'block';
      banner.style.transform = 'translateY(0)';
      banner.style.opacity = '1';
    }

    document.querySelectorAll('[data-price-card]').forEach((card) => {
      const originalPrice = card.querySelector('.original-price');
      const discountPrice = card.querySelector('.discount-price');
      if (!originalPrice || !discountPrice) return;

      const priceSpan = originalPrice.querySelector('.font-heading');
      const currencySpan = originalPrice.querySelector('.text-lg');
      if (priceSpan) {
        priceSpan.style.fontSize = '1.125rem';
        priceSpan.style.color = 'var(--color-text-muted)';
        priceSpan.style.textDecoration = 'line-through';
        priceSpan.style.fontWeight = '400';
      }
      if (currencySpan) {
        currencySpan.style.fontSize = '0.875rem';
        currencySpan.style.textDecoration = 'line-through';
      }

      discountPrice.style.display = 'block';
      discountPrice.style.opacity = '1';
      discountPrice.style.transform = 'translateY(0)';
    });
  }

  /* ---------- Обработчик закрытия баннера (in-flow) ---------- */
  function setupBannerCloseHandler() {
    const closeBtn = document.getElementById('banner-close-btn');
    if (!closeBtn) return;

    closeBtn.addEventListener('click', () => {
      const banner = document.getElementById('discount-banner');
      if (!banner) return;

      banner.style.transition = 'transform 0.6s cubic-bezier(0.55, 0, 1, 0.45), opacity 0.6s ease';
      banner.style.transform = 'translateY(100vh)';
      banner.style.opacity = '0';

      banner.addEventListener('transitionend', () => {
        banner.style.display = 'none';

        const badge = document.getElementById('compact-discount-badge');
        if (badge) {
          badge.style.display = 'block';
          badge.offsetHeight;
          badge.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          badge.style.opacity = '1';
          badge.style.transform = 'translateY(0)';
        }
      }, { once: true });
    }, { once: true });
  }

  /* ---------- Стили БОЛЬШОГО баннера (центр экрана) ---------- */
  function applyBigBannerStyles(banner) {
    var inner = banner.firstElementChild;
    var closeBtn = document.getElementById('banner-close-btn');
    var closeSvg = closeBtn && closeBtn.querySelector('svg');
    var pill = inner && inner.querySelector('.inline-flex');
    var discountSpan = pill && pill.children[0];
    var subtextSpan = pill && pill.children[1];
    var titleP = pill && pill.parentElement && pill.parentElement.querySelector('p');
    var isDesktop = window.innerWidth >= 768;

    if (inner) {
      inner.style.background = 'var(--color-primary-dark)';
      inner.style.padding = '2rem';
    }
    if (closeBtn) {
      closeBtn.style.width = '2.5rem';
      closeBtn.style.height = '2.5rem';
      closeBtn.style.background = 'rgba(255,255,255,0.2)';
      closeBtn.style.top = '1rem';
      closeBtn.style.right = '1rem';
    }
    if (closeSvg) {
      closeSvg.setAttribute('width', '20');
      closeSvg.setAttribute('height', '20');
    }
    if (pill) {
      pill.style.padding = '0.625rem 1.25rem';
      pill.style.marginBottom = '1rem';
    }
    if (discountSpan) discountSpan.style.fontSize = '1.5rem';
    if (subtextSpan) subtextSpan.style.fontSize = '1rem';
    if (titleP) {
      titleP.style.fontSize = '1.875rem';
      titleP.style.lineHeight = '2.25rem';
    }

    var timerCells = document.querySelectorAll('#countdown-timer > div > div:first-child');
    timerCells.forEach(function(cell) {
      cell.style.width = isDesktop ? '5rem' : '4rem';
      cell.style.height = isDesktop ? '5rem' : '4rem';
    });

    ['days','hours','minutes','seconds'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.fontSize = isDesktop ? '2.25rem' : '1.875rem';
    });
  }

  /* Плавный возврат внутренних элементов к CSS-классам */
  function transitionInnerToNormal(banner) {
    var t = 'all 0.6s ease-in-out';
    var inner = banner.firstElementChild;
    var closeBtn = document.getElementById('banner-close-btn');
    var closeSvg = closeBtn && closeBtn.querySelector('svg');
    var pill = inner && inner.querySelector('.inline-flex');
    var discountSpan = pill && pill.children[0];
    var subtextSpan = pill && pill.children[1];
    var titleP = pill && pill.parentElement && pill.parentElement.querySelector('p');
    var timerCells = document.querySelectorAll('#countdown-timer > div > div:first-child');
    var digitIds = ['days','hours','minutes','seconds'];

    // 1) Добавляем transition
    [inner, closeBtn, pill, discountSpan, subtextSpan, titleP].forEach(function(el) {
      if (el) el.style.transition = t;
    });
    timerCells.forEach(function(c) { c.style.transition = t; });
    digitIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.transition = t;
    });

    // SVG атрибуты — просто вернуть (не анимируются)
    if (closeSvg) {
      closeSvg.setAttribute('width', '16');
      closeSvg.setAttribute('height', '16');
    }

    // 2) Reflow чтобы transition применился
    banner.offsetHeight;

    // 3) Убираем big-overrides → CSS-классы берут верх, transition анимирует
    if (inner) { inner.style.background = ''; inner.style.padding = ''; }
    if (closeBtn) { closeBtn.style.width = ''; closeBtn.style.height = ''; closeBtn.style.background = ''; closeBtn.style.top = ''; closeBtn.style.right = ''; }
    if (pill) { pill.style.padding = ''; pill.style.marginBottom = ''; }
    if (discountSpan) discountSpan.style.fontSize = '';
    if (subtextSpan) subtextSpan.style.fontSize = '';
    if (titleP) { titleP.style.fontSize = ''; titleP.style.lineHeight = ''; }
    timerCells.forEach(function(c) { c.style.width = ''; c.style.height = ''; });
    digitIds.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.fontSize = '';
    });
  }

  /* Полная очистка inline-стилей с внутренних элементов */
  function cleanupInnerStyles(banner) {
    var inner = banner.firstElementChild;
    var closeBtn = document.getElementById('banner-close-btn');
    var pill = inner && inner.querySelector('.inline-flex');
    var discountSpan = pill && pill.children[0];
    var subtextSpan = pill && pill.children[1];
    var titleP = pill && pill.parentElement && pill.parentElement.querySelector('p');

    [inner, closeBtn, pill, discountSpan, subtextSpan, titleP].forEach(function(el) {
      if (el) el.removeAttribute('style');
    });
    document.querySelectorAll('#countdown-timer > div > div:first-child').forEach(function(c) {
      c.removeAttribute('style');
    });
    ['days','hours','minutes','seconds'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.removeAttribute('style');
    });
  }

  /* ---------- Драматичная анимация скидки ---------- */
  function startDramaticReveal() {
    sessionStorage.setItem('discount-shown', '1');

    const banner = document.getElementById('discount-banner');
    if (!banner || isDiscountExpired()) return;

    // Блокируем скролл на время оверлея
    const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
    document.body.style.overflow = 'hidden';
    document.body.style.paddingRight = scrollbarWidth + 'px';

    // 1. Оверлей — затемнение фона (opacity 0 → 0.6 за 300ms)
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:#000;z-index:99998;opacity:0;transition:opacity 0.3s ease;';
    document.body.appendChild(overlay);
    overlay.offsetHeight;
    overlay.style.opacity = '0.6';

    // 2. Баннер — БОЛЬШОЙ, фиксированный по центру, z-index выше всего
    banner.style.cssText = 'display:block;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.8);z-index:99999;opacity:0;width:90vw;max-width:700px;margin:0;';
    applyBigBannerStyles(banner);
    banner.offsetHeight;

    // Entrance: scale(0.8→1) + opacity(0→1) за 400ms
    banner.style.transition = 'transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.4s ease';
    banner.style.transform = 'translate(-50%,-50%) scale(1)';
    banner.style.opacity = '1';

    let landed = false;

    function landBanner() {
      if (landed) return;
      landed = true;

      // Разблокируем скролл
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';

      // 5. Оверлей исчезает
      overlay.style.transition = 'opacity 0.6s ease-in-out';
      overlay.style.opacity = '0';

      // Скроллим к Pricing мгновенно чтобы измерить целевую позицию
      const pricingSection = document.getElementById('pricing');
      if (pricingSection) {
        pricingSection.scrollIntoView({ behavior: 'auto', block: 'start' });
      }

      // --- Измеряем целевую позицию баннера в потоке ---
      const savedCss = banner.style.cssText;
      banner.style.cssText = 'display:block;visibility:hidden;position:static;';
      const targetRect = banner.getBoundingClientRect();
      // Восстанавливаем фиксированную позицию
      banner.style.cssText = savedCss;
      banner.style.opacity = '1';

      // Конвертируем текущую позицию из % в px (убираем translate)
      const startRect = banner.getBoundingClientRect();
      banner.style.transition = 'none';
      banner.style.top = startRect.top + 'px';
      banner.style.left = startRect.left + 'px';
      banner.style.width = startRect.width + 'px';
      banner.style.maxWidth = startRect.width + 'px';
      banner.style.transform = 'none';
      banner.offsetHeight;

      // 4. Анимация: баннер плавно уменьшается и перемещается на своё место (600ms)
      banner.style.transition = 'top 0.6s ease-in-out, left 0.6s ease-in-out, width 0.6s ease-in-out, max-width 0.6s ease-in-out';
      banner.style.top = targetRect.top + 'px';
      banner.style.left = targetRect.left + 'px';
      banner.style.width = targetRect.width + 'px';
      banner.style.maxWidth = targetRect.width + 'px';

      // Одновременно — внутренние элементы возвращаются к обычным размерам
      transitionInnerToNormal(banner);

      // 6. После завершения — removeAttribute('style'), баннер в потоке
      setTimeout(function() {
        overlay.remove();
        banner.removeAttribute('style');
        banner.style.display = 'block';
        cleanupInnerStyles(banner);

        // 7. Через 300ms — анимация цен
        setTimeout(function() {
          revealDiscountPrices();
          setupBannerCloseHandler();
        }, 300);
      }, 650);
    }

    // Крестик во время центрального показа — пропуск паузы
    const closeBtn = document.getElementById('banner-close-btn');
    let pauseTimeout;

    const onCloseCenter = () => {
      clearTimeout(pauseTimeout);
      landBanner();
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', onCloseCenter, { once: true });
    }

    // 3. Пауза 2.5 сек (отсчёт после завершения entrance 400ms)
    pauseTimeout = setTimeout(() => {
      if (closeBtn) closeBtn.removeEventListener('click', onCloseCenter);
      landBanner();
    }, 400 + 2500);
  }

  /* ---------- Триггеры ---------- */
  function setupDramaticTriggers() {
    let triggered = false;
    let bottomObserver = null;
    let pricingObserver = null;
    let pricingTimer = null;

    function fire() {
      if (triggered) return;
      triggered = true;
      if (bottomObserver) bottomObserver.disconnect();
      if (pricingObserver) pricingObserver.disconnect();
      if (pricingTimer) clearInterval(pricingTimer);
      startDramaticReveal();
    }

    // Триггер А: пользователь проскроллил НИЖЕ карточек
    const bottomEl = document.getElementById('pricing-bottom-trigger');
    if (bottomEl) {
      bottomObserver = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) fire();
      }, { threshold: 0.1 });
      bottomObserver.observe(bottomEl);
    }

    // Триггер Б: секция Pricing в viewport 12 секунд
    const pricingSection = document.getElementById('pricing');
    let visibleStart = 0;
    if (pricingSection) {
      pricingObserver = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          visibleStart = Date.now();
          pricingTimer = setInterval(() => {
            if (Date.now() - visibleStart >= 12000) fire();
          }, 500);
        } else {
          if (pricingTimer) { clearInterval(pricingTimer); pricingTimer = null; }
        }
      }, { threshold: 0.15 });
      pricingObserver.observe(pricingSection);
    }
  }

  /* ---------- Инициализация ---------- */
  if (isDiscountExpired()) {
    // Скидка истекла — обычные цены, баннер не нужен
  } else {
    updateCountdown();
    const countdownInterval = setInterval(() => {
      if (isDiscountExpired()) { clearInterval(countdownInterval); return; }
      updateCountdown();
    }, 1000);

    if (sessionStorage.getItem('discount-shown')) {
      // Повторный визит в сессии — сразу скидочное состояние без анимации
      applyDiscountedStateImmediately();
      setupBannerCloseHandler();
    } else {
      setupDramaticTriggers();
    }
  }
</script>
