<script>
(function() {
  // Дедлайн — если прошёл, выходим
  const deadline = new Date('2026-03-08T23:59:59+09:00');
  if (Date.now() > deadline.getTime()) return;

  const section = document.getElementById('pricing');
  const banner = document.getElementById('discount-banner');
  if (!section || !banner) return;

  // Обратный отсчёт в баннере на месте
  function updateBannerCountdown() {
    const now = Date.now();
    const diff = Math.max(0, deadline.getTime() - now);
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);

    const el = (id) => document.getElementById(id);
    if (el('days'))    el('days').textContent    = String(d).padStart(2, '0');
    if (el('hours'))   el('hours').textContent   = String(h).padStart(2, '0');
    if (el('minutes')) el('minutes').textContent = String(m).padStart(2, '0');
    if (el('seconds')) el('seconds').textContent = String(s).padStart(2, '0');
  }

  updateBannerCountdown();
  setInterval(updateBannerCountdown, 1000);

  // Если уже показывали — показать сразу без анимации
  if (sessionStorage.getItem('discount-shown') === '1') {
    showDiscountStatic();
    return;
  }

  let fired = false;
  let dwellTimer = null;

  // ТРИГГЕР: Observer на секцию pricing
  const obs = new IntersectionObserver((entries) => {
    const e = entries[0];
    if (e.isIntersecting) {
      // Запускаем таймер 12 сек
      dwellTimer = setTimeout(() => { if (!fired) runAnimation(); }, 12000);
    } else {
      clearTimeout(dwellTimer);
      // Если секция ушла вверх (пользователь проскроллил ниже)
      if (e.boundingClientRect.top < 0 && !fired) {
        runAnimation();
      }
    }
  }, { threshold: 0.1 });

  obs.observe(section);

  function runAnimation() {
    if (fired) return;
    fired = true;
    obs.disconnect();
    clearTimeout(dwellTimer);
    sessionStorage.setItem('discount-shown', '1');

    // 1. Создаём overlay
    const overlay = document.createElement('div');
    overlay.id = 'discount-overlay';
    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      background: 'rgba(0,0,0,0.7)',
      zIndex: '99998',
      opacity: '0',
      transition: 'opacity 0.3s ease'
    });
    document.body.appendChild(overlay);
    requestAnimationFrame(() => { overlay.style.opacity = '1'; });

    // 2. Создаём КЛОН баннера для показа по центру (не двигаем оригинал)
    const popup = document.createElement('div');
    popup.innerHTML = `
      <div style="
        background: #0F2B3C;
        border-radius: 1rem;
        padding: 2rem;
        width: 90vw;
        max-width: 700px;
        color: white;
        text-align: center;
        position: relative;
        box-shadow: 0 25px 60px rgba(0,0,0,0.6);
      ">
        <button id="discount-close" style="
          position: absolute; top: 0.75rem; right: 0.75rem;
          width: 2.5rem; height: 2.5rem;
          background: rgba(255,255,255,0.2);
          border: none; border-radius: 50%; cursor: pointer;
          display: flex; align-items: center; justify-content: center;
        ">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        <div style="
          display: inline-block; background: rgba(255,255,255,0.2);
          padding: 0.25rem 1rem; border-radius: 9999px;
          font-weight: 600; font-size: 1.25rem; margin-bottom: 0.75rem;
        ">−10% на любой тариф</div>
        <div style="font-size: 2rem; font-weight: 700;">Скидка до 8 марта</div>
        <div id="popup-timer" style="
          display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem;
        "></div>
      </div>
    `;
    Object.assign(popup.style, {
      position: 'fixed',
      top: '50%',
      left: '50%',
      transform: 'translate(-50%, -50%) scale(0.8)',
      zIndex: '99999',
      opacity: '0',
      transition: 'opacity 0.4s ease, transform 0.4s ease'
    });
    document.body.appendChild(popup);

    // Таймер в popup
    updatePopupTimer();
    const timerInterval = setInterval(updatePopupTimer, 1000);

    // Анимировать появление
    requestAnimationFrame(() => {
      popup.style.opacity = '1';
      popup.style.transform = 'translate(-50%, -50%) scale(1)';
    });

    // Закрытие по крестику, клику на overlay/popup, или через 4 сек
    let closed = false;
    function handleClose() {
      if (closed) return;
      closed = true;
      clearTimeout(closeTimeout);
      closePopup();
    }
    const closeTimeout = setTimeout(handleClose, 4000);
    popup.querySelector('#discount-close').addEventListener('click', handleClose);
    overlay.addEventListener('click', handleClose);
    popup.addEventListener('click', handleClose);

    function closePopup() {
      clearInterval(timerInterval);
      // Fade out popup и overlay
      popup.style.opacity = '0';
      popup.style.transform = 'translate(-50%, -50%) scale(0.9)';
      overlay.style.opacity = '0';

      // После fade out (400ms) — удалить popup и overlay, включить магнит
      setTimeout(() => {
        popup.remove();
        overlay.remove();

        // Показать баннер на месте (НЕ скидочные цены — они анимируются позже)
        banner.style.display = '';
        banner.style.opacity = '1';
        banner.style.transform = 'none';

        // Магнит тянет к pricing, после settled — анимация цен
        startScrollMagnet(section, () => {
          animatePrices();
        });
      }, 400);
    }

    function updatePopupTimer() {
      const now = Date.now();
      const diff = Math.max(0, deadline.getTime() - now);
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      const timer = popup.querySelector('#popup-timer');
      if (timer) {
        timer.innerHTML = [
          [d,'дн'],[h,'час'],[m,'мин'],[s,'сек']
        ].map(([v,l]) => `
          <div style="background:rgba(0,0,0,0.3);border-radius:0.75rem;padding:0.5rem;min-width:4rem;text-align:center">
            <div style="font-size:2rem;font-weight:700;font-family:monospace">${String(v).padStart(2,'0')}</div>
            <div style="font-size:0.75rem;opacity:0.7">${l}</div>
          </div>
        `).join('<div style="font-size:2rem;font-weight:700;line-height:4rem">:</div>');
      }
    }
  }

  function startScrollMagnet(targetSection, onSettled) {
    let settled = false;
    let settledTimer = null;

    function check() {
      if (settled) return;

      const rect = targetSection.getBoundingClientRect();
      const targetTop = -20; // небольшой отступ сверху

      // Если секция не у верхнего края экрана — тянем обратно
      if (Math.abs(rect.top - targetTop) > 50) {
        window.scrollTo({ top: targetSection.offsetTop - 20, behavior: 'smooth' });
      }

      // Проверяем: если секция у верхнего края и держится 300ms — считаем settled
      if (Math.abs(rect.top - targetTop) < 100) {
        if (!settledTimer) {
          settledTimer = setTimeout(() => {
            settled = true;
            onSettled(); // запускаем анимацию цен
          }, 300);
        }
      } else {
        clearTimeout(settledTimer);
        settledTimer = null;
      }

      if (!settled) {
        requestAnimationFrame(check);
      }
    }

    requestAnimationFrame(check);

    // Безопасный fallback — через 5 секунд всё равно settled
    setTimeout(() => {
      if (!settled) {
        settled = true;
        onSettled();
      }
    }, 5000);
  }

  function showDiscountStatic() {
    // Показать баннер на месте
    banner.style.display = '';
    banner.style.opacity = '1';
    banner.style.transform = 'none';
    // Показать скидочные цены, зачеркнуть оригинальные
    document.querySelectorAll('.discount-price').forEach(el => {
      el.style.display = '';
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    document.querySelectorAll('.original-price').forEach(el => {
      const priceSpan = el.querySelector('.font-heading');
      const currSpan = el.querySelector('.text-lg');
      if (priceSpan) {
        priceSpan.style.fontSize = '1.125rem';
        priceSpan.style.color = '#999';
        priceSpan.style.textDecoration = 'line-through';
        priceSpan.style.fontWeight = '400';
      }
      if (currSpan) {
        currSpan.style.fontSize = '0.875rem';
        currSpan.style.textDecoration = 'line-through';
      }
    });
  }

  function animatePrices() {
    document.querySelectorAll('[data-price-card]').forEach((card, i) => {
      setTimeout(() => {
        const orig = card.querySelector('.original-price');
        const disc = card.querySelector('.discount-price');
        if (orig) {
          const priceSpan = orig.querySelector('.font-heading');
          const currSpan = orig.querySelector('.text-lg');
          if (priceSpan) {
            priceSpan.style.transition = 'all 0.4s ease';
            priceSpan.style.fontSize = '1.125rem';
            priceSpan.style.color = '#999';
            priceSpan.style.textDecoration = 'line-through';
            priceSpan.style.fontWeight = '400';
          }
          if (currSpan) {
            currSpan.style.transition = 'all 0.4s ease';
            currSpan.style.fontSize = '0.875rem';
            currSpan.style.textDecoration = 'line-through';
          }
        }
        if (disc) {
          disc.style.display = '';
          disc.style.transition = 'all 0.4s ease';
          requestAnimationFrame(() => {
            disc.style.opacity = '1';
            disc.style.transform = 'translateY(0)';
          });
        }
      }, i * 300);
    });
  }
})();
</script>
