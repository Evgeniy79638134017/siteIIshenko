<script>
  const DEADLINE = new Date('2026-04-10T23:59:59+09:00').getTime();
  const discountActive = DEADLINE - Date.now() > 0;

  // Элементы
  const banner = document.getElementById('discount-banner');
  const overlay = document.getElementById('discount-overlay');
  const overlayBg = document.getElementById('discount-overlay-bg');
  const closeBtn = document.getElementById('discount-close');
  const ctaBtn = document.getElementById('discount-cta');
  const pricingSection = document.getElementById('pricing');
  const pricingGrid = document.getElementById('pricing-grid');
  const priceBlocks = pricingGrid ? pricingGrid.querySelectorAll('.price-block') : [];

  // Состояние
  let modalShown = false;       // модалка уже показывалась
  let pricesChanged = false;    // цены уже сменились на скидочные
  let watchTimer = null;        // таймер 20 сек
  let pricingVisible = false;   // секция на экране

  if (!discountActive) {
    // Скидка истекла — ничего не делаем, обычные цены
    if (banner) banner.style.display = 'none';
    if (overlay) overlay.style.display = 'none';
  } else {
    // === Таймер обратного отсчёта ===
    function updateCountdown() {
      const diff = DEADLINE - Date.now();
      if (diff <= 0) return;
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      // Баннер
      const de = document.getElementById('days');
      const he = document.getElementById('hours');
      const me = document.getElementById('minutes');
      const se = document.getElementById('seconds');
      if (de) de.textContent = String(d).padStart(2, '0');
      if (he) he.textContent = String(h).padStart(2, '0');
      if (me) me.textContent = String(m).padStart(2, '0');
      if (se) se.textContent = String(s).padStart(2, '0');

      // Модалка
      document.querySelectorAll('.modal-days').forEach(el => el.textContent = String(d).padStart(2, '0'));
      document.querySelectorAll('.modal-hours').forEach(el => el.textContent = String(h).padStart(2, '0'));
      document.querySelectorAll('.modal-mins').forEach(el => el.textContent = String(m).padStart(2, '0'));
      document.querySelectorAll('.modal-secs').forEach(el => el.textContent = String(s).padStart(2, '0'));
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // === Показ модалки ===
    function showModal() {
      if (modalShown || !overlay) return;
      modalShown = true;
      document.body.style.overflow = 'hidden';
      overlay.classList.remove('hidden');
      void overlay.offsetWidth;
      overlay.classList.add('visible');
    }

    // === Закрытие модалки + магнит к ценам ===
    function closeModal() {
      if (!overlay) return;
      overlay.classList.remove('visible');
      document.body.style.overflow = '';
      setTimeout(() => {
        overlay.classList.add('hidden');
        // Магнит — плавный скролл к ценам
        if (pricingSection) {
          pricingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        // Запускаем таймер 20 сек на просмотр цен
        startWatchTimer();
      }, 400);
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (ctaBtn) ctaBtn.addEventListener('click', closeModal);
    if (overlayBg) overlayBg.addEventListener('click', closeModal);

    // === Отслеживание: цены ушли с экрана → показываем модалку ===
    function onScroll() {
      if (!pricingGrid || modalShown) return;
      const rect = pricingGrid.getBoundingClientRect();
      // Цены полностью ушли вверх за экран
      if (rect.bottom < 0) {
        showModal();
        window.removeEventListener('scroll', onScrollForModal);
      }
    }

    function onScrollForModal() {
      onScroll();
    }
    window.addEventListener('scroll', onScrollForModal, { passive: true });

    // === Отслеживание видимости секции для таймера 20 сек ===
    function startWatchTimer() {
      if (pricesChanged || watchTimer) return;
      watchTimer = setTimeout(() => {
        if (!pricesChanged) {
          revealDiscountPrices();
        }
      }, 20000);
    }

    // Если человек уходит с секции — сбрасываем таймер
    const pricingObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        pricingVisible = entry.isIntersecting;
        if (pricingVisible && modalShown && !pricesChanged) {
          startWatchTimer();
        } else if (!pricingVisible && watchTimer && !pricesChanged) {
          clearTimeout(watchTimer);
          watchTimer = null;
        }
      });
    }, { threshold: 0.3 });

    if (pricingGrid) pricingObserver.observe(pricingGrid);

    // === Последовательная смена цен + появление баннера ===
    function revealDiscountPrices() {
      if (pricesChanged) return;
      pricesChanged = true;

      priceBlocks.forEach((block, i) => {
        setTimeout(() => {
          const orig = block.querySelector('.original-price');
          const disc = block.querySelector('.discount-price');
          if (orig) orig.classList.add('fade-out');
          if (disc) {
            disc.classList.remove('hidden');
            void disc.offsetWidth;
            disc.classList.add('show');
          }
        }, i * 500); // 0ms, 500ms, 1000ms — по очереди
      });

      // Баннер появляется после последней цены
      setTimeout(() => {
        if (banner) {
          banner.classList.remove('hidden');
          void banner.offsetWidth;
          banner.classList.add('show');
        }
      }, priceBlocks.length * 500 + 300);
    }
  }
</script>
