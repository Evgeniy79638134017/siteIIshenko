---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center px-4">
      <h1 class="font-heading font-bold text-4xl md:text-5xl text-primary">Сайт в разработке</h1>
      <p class="text-text-muted text-lg mt-4">Скоро здесь появится мастер-практикум</p>
      <a href="/contacts" class="mt-8 inline-block bg-accent text-white px-8 py-3 rounded-xl font-bold hover:bg-accent-hover transition-all">Записаться на диагностику</a>
    </div>
  </section>
</BaseLayout>
