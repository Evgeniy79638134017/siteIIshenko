---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Comparison from '../components/Comparison.astro';
import Solution from '../components/Solution.astro';
import Modules from '../components/Modules.astro';
import CaseStudy from '../components/CaseStudy.astro';
import CompetitorTable from '../components/CompetitorTable.astro';
import Pricing from '../components/Pricing.astro';
import ForWhom from '../components/ForWhom.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Guarantees from '../components/Guarantees.astro';
import FinalCTA from '../components/FinalCTA.astro';
import SectionDivider from '../components/SectionDivider.astro';
---
<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Евгений Ищенко",
      "jobTitle": "Эксперт по продажам в соцсетях и автоматизации на базе ИИ",
      "url": "https://siteishchenko.vercel.app",
      "sameAs": ["https://t.me/Evgen_isch"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Благовещенск",
        "addressRegion": "Амурская область",
        "addressCountry": "RU"
      }
    })} />
  </Fragment>
  <Hero />
  <SectionDivider variant="signal" />
  <Problems />
  <SectionDivider variant="circuit" />
  <Comparison />
  <SectionDivider variant="equalizer" />
  <Solution />
  <SectionDivider variant="circuit" />
  <Modules />
  <SectionDivider variant="signal" />
  <CaseStudy />
  <SectionDivider variant="equalizer" />
  <CompetitorTable />
  <SectionDivider variant="circuit" />
  <Pricing />
  <SectionDivider variant="equalizer" />
  <ForWhom />
  <SectionDivider variant="circuit" />
  <Testimonials />
  <SectionDivider variant="signal" />
  <FAQ />
  <SectionDivider variant="equalizer" />
  <Guarantees />
  <SectionDivider variant="signal" />
  <FinalCTA />
</BaseLayout>
